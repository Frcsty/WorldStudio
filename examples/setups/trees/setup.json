{
  "$schema": "../setup.schema.json",
  "schemaVersion": 1,
  "id": "trees",
  "name": "Trees",
  "description": "Seeded tree design workshop on a flat grass world. Generated by trusted local style modules.",
  "adapter": "trees",
  "folders": {
    "worlds": "setups/trees/worlds",
    "assets": "render/default",
    "projects": "setups/trees/projects"
  },
  "worlds": {
    "exclude": [],
    "references": []
  },
  "worldCodecs": [
    "json-sections-v1"
  ],
  "reviewer": "Owner",
  "reviewExport": "scene",
  "exports": [
    {
      "id": "scene",
      "name": "Tree gallery scene JSON",
      "format": "scene-json",
      "folder": "setups/trees/exports"
    }
  ],
  "benchModels": {},
  "options": {
    "generations": "setups/trees/generations"
  }
}
