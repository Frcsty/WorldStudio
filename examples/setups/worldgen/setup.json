{
  "$schema": "../setup.schema.json",
  "schemaVersion": 1,
  "id": "worldgen",
  "name": "World generation",
  "description": "Procedurally generated, streamed worlds (tiled-v1). Generated by trusted local generator modules.",
  "adapter": "worldgen",
  "folders": {
    "worlds": "setups/worldgen/worlds",
    "assets": "render/default",
    "projects": "setups/worldgen/projects"
  },
  "worlds": { "exclude": [], "references": [] },
  "reviewer": "Owner",
  "reviewExport": "scene",
  "exports": [
    { "id": "scene", "name": "Portable scene JSON", "format": "scene-json", "folder": "setups/worldgen/exports" }
  ],
  "benchModels": {}
}
